# Reference material (motion/animation clips Lindsey drops in for analysis).
# This repo is public — reference clips of other products' motion shouldn't
# get published in it. Folder itself stays tracked via .gitkeep so it exists
# on clone; everything dropped inside it is ignored.
reference/*
!reference/.gitkeep

# Real NYT content (video, images, article assets) staged for the eventual
# hi-fi swap (M6). This repo is public — proprietary editorial content does
# not belong in it, same reasoning as the font decision. Stays local until
# fold-in to napp-100, which is Tailscale-gated.
assets/*
!assets/.gitkeep

.DS_Store
